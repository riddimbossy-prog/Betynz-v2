# One-service Betynz + SportyBet core
PORT=10000
SPORTYBET_INTERNAL_PORT=10001
SPORTYBET_COUNTRY=gh

SPORTYBET_PUBLIC_UPCOMING_URL=https://www.sportybet.com/api/{country}/factsCenter/pcUpcomingEvents?sportId=sr%3Asport%3A1&marketId=1&pageNum={page}&pageSize={page_size}
SPORTYBET_PUBLIC_LIVE_URL=https://www.sportybet.com/api/{country}/factsCenter/pcLiveEvents?sportId=sr%3Asport%3A1&marketId=1&pageNum={page}&pageSize={page_size}
SPORTYBET_PUBLIC_RESULTS_URL=https://www.sportybet.com/api/{country}/factsCenter/pcResults?sportId=sr%3Asport%3A1&date={date}&pageNum={page}&pageSize={page_size}
SPORTYBET_PUBLIC_EVENT_DETAIL_URL=https://www.sportybet.com/api/{country}/factsCenter/pcEvent?eventId={event_id}

# Optional override. If omitted, the combined launcher creates a private random internal key at startup.
SPORTYBET_API_KEY=

# API-Football enrichment: crests, league artwork and secondary statistics only.
# SportyBet remains authoritative for fixtures, odds, live scores, results and primary engine statistics.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY_HEADER=x-apisports-key
API_FOOTBALL_TIMEOUT_MS=20000
API_FOOTBALL_RETRIES=2
API_FOOTBALL_CACHE_TTL_SECONDS=1800
API_FOOTBALL_VISUAL_CACHE_TTL_SECONDS=604800
API_FOOTBALL_ENRICH_CONCURRENCY=3
API_FOOTBALL_HISTORY_LAST=40
API_FOOTBALL_MAPPING_THRESHOLD=0.55
API_FOOTBALL_DEEP_STATS=true

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTO_SETTLEMENT_ENABLED=true
AUTO_SETTLEMENT_INTERVAL_MINUTES=30
# Rate-limit-safe full-day processing
ALLOW_INTERNAL_RATE_LIMIT_BYPASS=true
BETYNZ_DATA_API_ENRICH_CONCURRENCY=2
BETYNZ_DATA_API_ACTION_CONCURRENCY=2
BETYNZ_DATA_API_ACTION_MIN_INTERVAL_MS=250
BETYNZ_DATA_API_RETRY_BASE_MS=1000
BETYNZ_DATA_API_RETRY_MAX_MS=30000
SPORTYBET_UPSTREAM_CONCURRENCY=2
SPORTYBET_UPSTREAM_MIN_INTERVAL_MS=250
SPORTYBET_UPSTREAM_RETRIES=4
SPORTYBET_UPSTREAM_BACKOFF_BASE_MS=1000
SPORTYBET_UPSTREAM_BACKOFF_MAX_MS=30000
API_FOOTBALL_ENRICH_CONCURRENCY=2
API_FOOTBALL_REQUEST_CONCURRENCY=3
API_FOOTBALL_REQUEST_MIN_INTERVAL_MS=200
API_FOOTBALL_RETRY_BASE_MS=1000
API_FOOTBALL_RETRY_MAX_MS=30000

