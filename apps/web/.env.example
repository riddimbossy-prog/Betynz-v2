APP_NAME=Betynz
NODE_ENV=development
PORT=10000
NODE_VERSION=20
CACHE_TTL_SECONDS=120

# SportyBet authority: fixtures, odds, live scores and results.
# Use the same secret configured as SPORTYBET_API_KEY on the API service.
BETYNZ_DATA_API_BASE_URL=https://YOUR-SPORTYBET-API.onrender.com/
BETYNZ_DATA_API_KEY=use_the_same_value_as_SPORTYBET_API_KEY
BETYNZ_DATA_API_KEY_HEADER=X-API-Key
BETYNZ_DATA_API_FIXTURES_PATH=search_matches?date={date}&page=1&page_size=100
BETYNZ_DATA_API_PAGE_SIZE=100
BETYNZ_DATA_API_MAX_PAGES=0
BETYNZ_DATA_API_TIMEOUT_MS=60000
BETYNZ_DATA_API_RETRIES=2
BETYNZ_DATA_API_ENRICH_CONCURRENCY=3
BETYNZ_DATA_API_MEDIA_BASE_URL=https://www.sportybet.com/
BETYNZ_DATA_API_FIXTURE_STATS_PATH=get_fixture_stats
BETYNZ_DATA_API_TEAM_HISTORY_PATH=get_team_history
BETYNZ_DATA_API_TEAM_STREAKS_PATH=get_team_streaks
BETYNZ_DATA_API_STANDINGS_PATH=get_standings
BETYNZ_DATA_API_COMPETITION_STATS_PATH=get_competition_stats
BETYNZ_DATA_API_LIVE_PATH=live
BETYNZ_DATA_API_RESULTS_PATH=results
BETYNZ_DATA_API_EVENTS_PATH=events
BETYNZ_DATA_API_EVENT_ID_PARAM=event_id


# API-Football enrichment: statistics and official visuals only.
# SportyBet remains authoritative for fixtures, odds, live scores and results.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY_HEADER=x-apisports-key
API_FOOTBALL_TIMEOUT_MS=20000
API_FOOTBALL_RETRIES=2
API_FOOTBALL_CACHE_TTL_SECONDS=1800
API_FOOTBALL_VISUAL_CACHE_TTL_SECONDS=604800
API_FOOTBALL_ENRICH_CONCURRENCY=3
API_FOOTBALL_HISTORY_LAST=40
API_FOOTBALL_MAPPING_THRESHOLD=0.55
API_FOOTBALL_DEEP_STATS=true

# Supabase is storage only: admin, frozen predictions, proof, settlement and learning.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

AUTO_SETTLEMENT_ENABLED=true
AUTO_SETTLEMENT_INTERVAL_MINUTES=30
FIXTURE_BOARD_CACHE_TTL_SECONDS=60
MATCH_INTELLIGENCE_CACHE_TTL_SECONDS=600
ODDS_SNAPSHOT_INTERVAL_SECONDS=300
LIVE_CACHE_TTL_SECONDS=20
RESULTS_CACHE_TTL_SECONDS=300
LEAGUE_CLASSIFICATION_CACHE_TTL_SECONDS=1800
PPG_ROUTE_CACHE_TTL_SECONDS=1800
CONVERGENCE_ROUTE_CACHE_TTL_SECONDS=1800
STATS_ROUTE_CACHE_TTL_SECONDS=1800
CONSENSUS_FREEZE_MINUTES=30
CONSENSUS_CACHE_TTL_SECONDS=180
# Rate-limit-safe full-day processing
ALLOW_INTERNAL_RATE_LIMIT_BYPASS=true
BETYNZ_DATA_API_ENRICH_CONCURRENCY=2
BETYNZ_DATA_API_ACTION_CONCURRENCY=2
BETYNZ_DATA_API_ACTION_MIN_INTERVAL_MS=250
BETYNZ_DATA_API_RETRY_BASE_MS=1000
BETYNZ_DATA_API_RETRY_MAX_MS=30000
SPORTYBET_UPSTREAM_CONCURRENCY=2
SPORTYBET_UPSTREAM_MIN_INTERVAL_MS=250
SPORTYBET_UPSTREAM_RETRIES=4
SPORTYBET_UPSTREAM_BACKOFF_BASE_MS=1000
SPORTYBET_UPSTREAM_BACKOFF_MAX_MS=30000
API_FOOTBALL_ENRICH_CONCURRENCY=2
API_FOOTBALL_REQUEST_CONCURRENCY=3
API_FOOTBALL_REQUEST_MIN_INTERVAL_MS=200
API_FOOTBALL_RETRY_BASE_MS=1000
API_FOOTBALL_RETRY_MAX_MS=30000

