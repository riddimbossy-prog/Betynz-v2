PORT=10000
NODE_ENV=development

# API-Football is the core fixture/odds/live/history provider.
# TheStatsAPI is optional enrichment for Atlas streak/xG intelligence.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY_HEADER=x-apisports-key
API_FOOTBALL_TIMEOUT_MS=20000
API_FOOTBALL_RETRIES=2
API_FOOTBALL_CACHE_TTL_SECONDS=1800
API_FOOTBALL_FIXTURE_CACHE_TTL_SECONDS=120
API_FOOTBALL_ODDS_CACHE_TTL_SECONDS=300
API_FOOTBALL_VISUAL_CACHE_TTL_SECONDS=604800
API_FOOTBALL_ENRICH_CONCURRENCY=2
API_FOOTBALL_REQUEST_CONCURRENCY=1
API_FOOTBALL_REQUEST_MIN_INTERVAL_MS=750
API_FOOTBALL_REQUESTS_PER_MINUTE=8
API_FOOTBALL_RATE_LIMIT_RETRIES=6
API_FOOTBALL_RATE_LIMIT_COOLDOWN_MS=65000
API_FOOTBALL_RETRY_BASE_MS=1000
API_FOOTBALL_RETRY_MAX_MS=30000
API_FOOTBALL_HISTORY_LAST=40
API_FOOTBALL_ENGINE_LEAGUE_HISTORY=true
API_FOOTBALL_ENGINE_HISTORY_TTL_SECONDS=43200
API_FOOTBALL_MAPPING_THRESHOLD=0.55
API_FOOTBALL_DEEP_STATS=true
API_FOOTBALL_TIMEZONE=UTC
API_FOOTBALL_MAX_ODDS_PAGES=0

# Optional: force one bookmaker from the API-Football odds feed.
API_FOOTBALL_BOOKMAKER_ID=
API_FOOTBALL_BOOKMAKER_NAME=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTO_SETTLEMENT_ENABLED=true
AUTO_SETTLEMENT_INTERVAL_MINUTES=10
AUTO_SETTLEMENT_LOOKBACK_DAYS=3
SETTLEMENT_TRIGGER_COOLDOWN_SECONDS=90
WIN_CAROUSEL_DAYS=14
WIN_CAROUSEL_LIMIT=24
WIN_CAROUSEL_CACHE_TTL_SECONDS=60

API_FOOTBALL_MEDIA_BASE_URL=https://media.api-sports.io/football
API_FOOTBALL_MEDIA_CONCURRENCY=6
API_FOOTBALL_MEDIA_TIMEOUT_MS=10000

# TheStatsAPI — Atlas Streak Value enrichment (separate queue from API-Football)
STATS_API_KEY=
STATS_API_BASE_URL=https://api.thestatsapi.com/api
STATS_API_TIMEOUT_MS=15000
STATS_API_CONCURRENCY=2
STATS_API_MIN_INTERVAL_MS=300
STATS_API_REQUESTS_PER_MINUTE=40
STATS_API_RETRIES=3
STATS_API_RATE_LIMIT_COOLDOWN_MS=30000
STATS_API_HISTORY_LAST=10
STATS_API_CACHE_TTL_SECONDS=1800
STATS_API_TEAM_CACHE_TTL_SECONDS=43200
STATS_API_MAPPING_THRESHOLD=0.72
STATS_API_GOAL_STATS_LOOKBACK=4
STATS_VALUE_CONCURRENCY=2
STATS_VALUE_CACHE_TTL_SECONDS=1800

# Zeus statistical supervisor
ZEUS_CACHE_TTL_SECONDS=1800
